# ---------------------------------------------------------------------------
# Copia questo file in .env.local e riempi i valori.
# .env.local e' in .gitignore: nessun segreto va committato, nemmeno come
# fallback hardcodato nel codice.
# ---------------------------------------------------------------------------

# Supabase - valori pubblici, esposti al browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase - SOLO server-side. Mai importare in un Client Component,
# mai prefissare con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend - invio email transazionali (conferme prenotazione, form contatti)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Stripe - solo modulo eventi. La spesa si paga in loco, nessun gateway.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
